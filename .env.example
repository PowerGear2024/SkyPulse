# =============================================================================
# Пример конфигурации окружения
# Скопируй:  cp .env.example .env
# =============================================================================

# --- Telegram USER-сессия (не бот!) ---
# https://my.telegram.org/apps
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef

# Имя файла сессии (только латиница/цифры/_/-)
TELEGRAM_SESSION_NAME=user

# Опционально: StringSession (python -m bot.login)
# TELEGRAM_SESSION_STRING=

# Кто может писать в ЛС (telegram id через запятую).
# ПУСТО = отвечать всем (жрёт бюджет LLM). Рекомендуется заполнить.
# Узнать id: @userinfobot
ALLOWED_USER_IDS=

# --- LLM ---
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
OPENAI_MODEL=gpt-4o
ANTHROPIC_MODEL=claude-sonnet-4-20250514
LLM_TEMPERATURE=0.85
HISTORY_LIMIT=14
LLM_TIMEOUT_SEC=90

DATABASE_PATH=data/bot.db
LOG_LEVEL=INFO
