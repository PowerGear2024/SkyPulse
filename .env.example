# =============================================================================
# Пример конфигурации окружения
# Скопируй этот файл в .env и заполни реальными значениями:
#   cp .env.example .env
# =============================================================================

# Токен бота от @BotFather (обязательно)
BOT_TOKEN=1234567890:AAHdqTcvCH1vGWJxfSeofSAs0K5PALDsaw

# Провайдер LLM: openai | anthropic
LLM_PROVIDER=openai

# API-ключ выбранного провайдера (обязательно)
# OpenAI: https://platform.openai.com/api-keys
# Anthropic: https://console.anthropic.com/
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# Модели (по умолчанию — лучшие для кода и живого общения)
OPENAI_MODEL=gpt-4o
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Температура генерации: 0.8–0.9 даёт живой вайб без бреда
LLM_TEMPERATURE=0.85

# Сколько последних реплик держать в контексте (10–15 рекомендуется)
HISTORY_LIMIT=14

# Путь к файлу SQLite (создаётся автоматически)
DATABASE_PATH=data/bot.db

# Уровень логирования: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
