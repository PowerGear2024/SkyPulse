# =============================================================================
# Пример конфигурации окружения
# Скопируй:  cp .env.example .env
# =============================================================================

# --- Telegram USER-сессия (не бот!) ---
# Получить API_ID и API_HASH: https://my.telegram.org/apps
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef

# Имя файла сессии (без расширения) ИЛИ готовая StringSession
# Файл появится как data/user.session после первого логина
TELEGRAM_SESSION_NAME=user

# Опционально: StringSession (удобно для серверов, тогда файл не нужен)
# Сгенерировать: python -m bot.login
# TELEGRAM_SESSION_STRING=

# --- LLM ---
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
OPENAI_MODEL=gpt-4o
ANTHROPIC_MODEL=claude-sonnet-4-20250514
LLM_TEMPERATURE=0.85
HISTORY_LIMIT=14

# Путь к SQLite
DATABASE_PATH=data/bot.db

# Уровень логирования: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
