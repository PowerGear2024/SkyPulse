# =============================================================================
# cp .env.example .env
# =============================================================================

# --- Telegram USER-сессия ---
# https://my.telegram.org/apps
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef
TELEGRAM_SESSION_NAME=user
# TELEGRAM_SESSION_STRING=

# Группы, где работаем (отрицательные id супергрупп). ОБЯЗАТЕЛЬНО одно из двух:
# ALLOWED_CHAT_IDS=-100123...
# или явно ALLOW_ALL_CHATS=true (опасно — все группы аккаунта)
ALLOWED_CHAT_IDS=
ALLOW_ALL_CHATS=false

# Кто может триггерить ответ (пусто = все в разрешённых чатах).
# Память всё равно пишет ВСЕ сообщения чата.
ALLOWED_USER_IDS=

# mention = только @ты или reply на твоё сообщение (рекомендуется)
# all = отвечать на каждое текстовое сообщение в группе
GROUP_REPLY_MODE=mention

# Отвечать, когда ставят реакцию на ТВОЁ сообщение
REPLY_ON_REACTIONS=true

# Иногда сам вкинуть тему по 10 смс одного юзера (не больше N раз в день)
PROACTIVE_ENABLED=true
PROACTIVE_MAX_PER_DAY=5
# Как часто проверять «не пора ли вкинуть» (секунды) + шанс срабатывания
PROACTIVE_CHECK_SEC=1800
PROACTIVE_CHANCE=0.35

# Рабочие часы бота (локальная таймзона). Вне окна — полный молчок.
TIMEZONE=Europe/Kyiv
WORK_HOURS_START=8
WORK_HOURS_END=18
# Если сам написал с аккаунта — бот паузится, пока не выйдешь из TG
# (offline/recently). Запасной авто-resume, если статус не пришёл (сек).
OWNER_IDLE_RESUME_SEC=600

# --- LLM ---
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
OPENAI_MODEL=gpt-4o
ANTHROPIC_MODEL=claude-sonnet-4-20250514
LLM_TEMPERATURE=0.85
# Сколько последних сообщений чата держать в памяти
HISTORY_LIMIT=30
LLM_TIMEOUT_SEC=90

DATABASE_PATH=data/bot.db
# ALLOW_UNSAFE_DB_PATH=true  # только если DATABASE_PATH вне проекта
LOG_LEVEL=INFO
